# Base de datos PostgreSQL / TimescaleDB
POSTGRES_USER=admin
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_DB=telemetria

# Backend Fastify
JWT_SECRET=tu_jwt_secret_aqui
HOST_IPS=

# Frontend (Vite)
VITE_CARTO_API_KEY=tu_carto_api_key_aqui
